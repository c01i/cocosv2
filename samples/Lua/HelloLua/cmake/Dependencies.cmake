# libjpeg-turbo deliberately rejects add_subdirectory(). Build its static library separately.
set(JPEG_CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=${jpeg_BINARY_DIR}/install -DENABLE_SHARED=OFF
    -DENABLE_STATIC=ON -DWITH_SIMD=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    -DCMAKE_BUILD_TYPE=Debug -DCMAKE_POLICY_VERSION_MINIMUM=3.5)
list(APPEND JPEG_CMAKE_ARGS -DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
    -DANDROID_ABI=${ANDROID_ABI} -DANDROID_PLATFORM=${ANDROID_PLATFORM})
ExternalProject_Add(jpeg_build SOURCE_DIR "${jpeg_SOURCE_DIR}" BINARY_DIR "${jpeg_BINARY_DIR}"
    CMAKE_GENERATOR "Unix Makefiles" CMAKE_ARGS ${JPEG_CMAKE_ARGS}
    BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --target jpeg-static
    INSTALL_COMMAND "" BUILD_BYPRODUCTS "${jpeg_BINARY_DIR}/libjpeg.a")
add_library(jpeg-static STATIC IMPORTED GLOBAL)
set_target_properties(jpeg-static PROPERTIES IMPORTED_LOCATION "${jpeg_BINARY_DIR}/libjpeg.a")
add_dependencies(jpeg-static jpeg_build)
